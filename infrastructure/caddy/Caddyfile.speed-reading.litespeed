    @sitemap path /sitemap.xml
    handle @sitemap {
        uri replace /sitemap.xml /api/speed-reading/sitemap.xml
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # Identity login, registration and token endpoints are exposed directly
    # under the gateway's /api/auth contract. Keep this allowlist narrow so
    # unrelated /api paths remain blocked on the speed-reading domain.
    @identityAuth path /api/auth /api/auth/*
    handle @identityAuth {
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # The current standalone client updates the identity-owned profile through
    # the Gateway's unversioned users contract. Keep this single profile route
    # explicitly exposed while leaving unrelated identity routes closed.
    @identityProfile path /api/users/me /api/users/me/*
    handle @identityProfile {
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # The admin client uses the coaching service's dedicated administrative
    # contract. Keep it explicit so generic /api paths remain closed.
    @versionedCoachingAdmin path /api/v1/coaching-admin /api/v1/coaching-admin/*
    handle @versionedCoachingAdmin {
        uri replace /api/v1 /api
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    # The existing frontend still emits /api/v1 for a small, explicit set of
    # SpeedReading and identity routes while the Gateway contract is /api.
    # Strip only this allowlisted compatibility surface before proxying.
    @versionedApi path /api/v1/auth /api/v1/auth/* /api/v1/users /api/v1/users/* /api/v1/users/me /api/v1/users/me/* /api/v1/user-settings /api/v1/user-settings/* /api/v1/students /api/v1/students/* /api/v1/teachers /api/v1/teachers/* /api/v1/institutions /api/v1/institutions/* /api/v1/roles /api/v1/roles/* /api/v1/exercises /api/v1/exercises/* /api/v1/exercisetypes /api/v1/exercisetypes/* /api/v1/exercise-types /api/v1/exercise-types/* /api/v1/exercise-sessions /api/v1/exercise-sessions/* /api/v1/daily-progress /api/v1/daily-progress/* /api/v1/program-templates /api/v1/program-templates/* /api/v1/learningpath /api/v1/learningpath/* /api/v1/reading-texts /api/v1/reading-texts/* /api/v1/reading-questions /api/v1/reading-questions/* /api/v1/exam-questions /api/v1/exam-questions/* /api/v1/analytics /api/v1/analytics/* /api/v1/reports /api/v1/reports/* /api/v1/gamification /api/v1/gamification/* /api/v1/adaptive-learning /api/v1/adaptive-learning/* /api/v1/student-program /api/v1/student-program/* /api/v1/age-group-configurations /api/v1/age-group-configurations/* /api/v1/assessment /api/v1/assessment/* /api/v1/assessment-templates /api/v1/assessment-templates/* /api/v1/contentfeedback /api/v1/contentfeedback/* /api/v1/review /api/v1/review/* /api/v1/vocabulary /api/v1/vocabulary/* /api/v1/visualization /api/v1/visualization/* /api/v1/visualization-scenes /api/v1/visualization-scenes/* /api/v1/series-access /api/v1/series-access/*
    handle @versionedApi {
        uri replace /api/v1 /api
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    @health path /health /health/*
    handle @health {
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    @signalr path /hubs/*
    handle @signalr {
        reverse_proxy api-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }

    @blockedApi path /api/*
    handle @blockedApi {
        respond "Not Found" 404
    }

    handle {
        reverse_proxy speed-reading-frontend:80
    }
}
