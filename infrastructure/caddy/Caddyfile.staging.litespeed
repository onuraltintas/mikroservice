{
	auto_https off

	# LiteSpeed is the only public edge and forwards requests to this
	# dedicated loopback listener. Trust only the staging Docker gateway
	# when consuming forwarded client/protocol headers.
	servers {
		trusted_proxies static 127.0.0.1/32 172.30.0.1/32
	}
}

# The listener is dedicated to this staging vhost, so do not depend on
# LiteSpeed preserving the original Host header on the internal hop.
:80 {
	encode gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	@api path /api/*
	handle @api {
		reverse_proxy api-gateway:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	@health path /health /health/*
	handle @health {
		reverse_proxy api-gateway:8080 {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy admin-panel:4000
	}
}
