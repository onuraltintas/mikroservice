# Copy to /etc/eduivme/db-backup.env (chmod 600). Without BACKUP_RCLONE_REMOTE only the server copy is kept.
# Off-site copy: an rclone remote configured with `rclone config` (e.g. Backblaze B2 or Cloudflare R2) and a folder.
BACKUP_RCLONE_REMOTE=
# age public key (age1…). Keep the private key OFF the server (password manager); it is needed only to restore.
BACKUP_AGE_RECIPIENT=
# Off-site copies older than this are deleted (6 months + margin).
BACKUP_REMOTE_KEEP_DAYS=190
# Optional: healthchecks.io style URL; pinged on success, <url>/fail on failure.
BACKUP_HEALTHCHECK_URL=
