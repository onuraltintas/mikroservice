# Copy to .env and replace every placeholder before starting Docker Compose.
ENVIRONMENT=Development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eduplatform
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB_IDENTITY=identity_db
POSTGRES_DB_COACHING=coaching_db
POSTGRES_DB_NOTIFICATION=notification_db

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=eduplatform
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password

# JWT (all services must share these values)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eduplatform.identity
JWT_AUDIENCE=eduplatform.api
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Service-to-service authentication (Notification -> Identity)
INTERNAL_SERVICE_API_KEY=replace-with-a-long-random-service-key

# SMTP / local development mail catcher
SMTP_HOST=mailcatcher
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@eduplatform.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduPlatform

# Gateway
GATEWAY_PORT=5000
