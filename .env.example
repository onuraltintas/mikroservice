# Copy to .env and replace every placeholder before starting Docker Compose.
ENVIRONMENT=Development

# Development/E2E demo seed only. Keep empty in Production.
TEST_ADMIN_PASSWORD=
TEST_DEFAULT_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=eduplatform
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB_IDENTITY=identity_db
POSTGRES_DB_COACHING=coaching_db
POSTGRES_DB_NOTIFICATION=notification_db
# Keep the sum of service pools below PostgreSQL max_connections; tune per replica.
POSTGRES_MAX_POOL_SIZE=30

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=eduplatform
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-password

# JWT (all services must share these values)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=eduplatform.identity
JWT_AUDIENCE=eduplatform.api
# Optional key-ring rotation settings. Deploy the new secret together with the
# previous one, switch JWT_KEY_ID, then remove the previous value after the
# maximum access-token lifetime has elapsed.
JWT_KEY_ID=2026-08
JWT_PREVIOUS_SECRETS=
JWT_PREVIOUS_KEY_IDS=
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Google Identity Services web client ID (public identifier, not a secret).
# The identity service rejects Google ID tokens when this value is missing.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# Service-to-service authentication (Notification -> Identity)
INTERNAL_SERVICE_API_KEY=replace-with-a-long-random-service-key

# Production Data Protection key-at-rest encryption. Mount the same PFX/PKCS#12
# certificate into each service and set its in-container path and password.
# DATAPROTECTION_CERTIFICATE_HOST_PATH=/secure/path/eduplatform-dataprotection.pfx
# DATAPROTECTION_CERTIFICATE_PATH=/run/secrets/eduplatform-dataprotection.pfx
# DATAPROTECTION_CERTIFICATE_PASSWORD=replace-with-a-secret

# SMTP / local development mail catcher
SMTP_HOST=mailcatcher
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@eduplatform.local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=EduPlatform

# Public browser origin used in verification and password-reset links.
PUBLIC_APP_BASE_URL=http://localhost:4200

# Coaching assignment photo scanning. Local keeps development self-contained;
# use ClamAv with the optional `security-scan` Compose profile before Production.
ATTACHMENT_SCANNER_PROVIDER=Local
ATTACHMENT_SCANNER_CLAMAV_HOST=clamav
ATTACHMENT_SCANNER_CLAMAV_PORT=3310
ATTACHMENT_SCANNER_TIMEOUT_SECONDS=10

# Coaching attachment storage. Local is suitable for development only;
# Minio uses the optional object-storage Compose profile and is required in Production.
ATTACHMENT_STORAGE_PROVIDER=Local
ATTACHMENT_MINIO_ENDPOINT=minio:9000
ATTACHMENT_MINIO_ACCESS_KEY=replace-with-a-minio-access-key
ATTACHMENT_MINIO_SECRET_KEY=replace-with-a-long-random-minio-secret
ATTACHMENT_MINIO_BUCKET=eduplatform-attachments
ATTACHMENT_MINIO_USE_SSL=false
MINIO_ROOT_USER=replace-with-a-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-secret

# Gateway
GATEWAY_PORT=5000

# Staging VPS edge (keep .env.staging outside Git and replace placeholders).
STAGING_DOMAIN=staging.example.com
TLS_ACME_EMAIL=ops@example.com
STAGING_HTTP_PORT=80
STAGING_HTTPS_PORT=443

# Optional trusted ingress proxy configuration for client-IP rate limiting.
# Leave empty when the Gateway is directly internet-facing. Use comma-separated
# proxy IPs/networks only when these addresses are controlled by your platform.
# Valid range: 1-10
FORWARDED_HEADERS_FORWARD_LIMIT=1
FORWARDED_HEADERS_KNOWN_PROXIES=
FORWARDED_HEADERS_KNOWN_NETWORKS=

# Optional OSS observability overlay (docker-compose.observability.yml)
OTEL_TRACES_SAMPLER_ARG=0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
PGADMIN_DEFAULT_EMAIL=admin@eduplatform.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-long-random-password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
REDIS_MAX_MEMORY=512mb
