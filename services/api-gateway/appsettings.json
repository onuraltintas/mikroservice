{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Maintenance": {
      "CacheSeconds": 5,
      "BypassRoles": [ "SystemAdmin", "InstitutionOwner" ],
      "BypassPathPrefixes": [ "/api/auth", "/api/configurations" ]
    },
    "RateLimiting": {
      "Enabled": true,
      "KeyPrefix": "EduPlatform:RateLimit",
      "RedisRetryAfterFailureSeconds": 5,
      "AuthenticatedUser": {
        "Enabled": true,
        "PermitLimit": 600,
        "WindowSeconds": 60,
        "ExcludedPathPrefixes": [
          "/hubs"
        ]
      },
      "Rules": [
        {
          "Name": "auth-email",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/auth/forgot-password",
            "/api/auth/resend-verification-email"
          ],
          "PermitLimit": 5,
          "WindowSeconds": 900
        },
        {
          "Name": "auth-password-reset",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/auth/reset-password"
          ],
          "PermitLimit": 10,
          "WindowSeconds": 900
        },
        {
          "Name": "auth-email-confirmation",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/auth/confirm-email"
          ],
          "PermitLimit": 10,
          "WindowSeconds": 900
        },
        {
          "Name": "auth-registration",
          "Methods": [
            "POST"
          ],
          "PathPrefixes": [
            "/api/auth/coaching/register",
            "/api/auth/speed-reading/register"
          ],
          "PermitLimit": 15,
          "WindowSeconds": 60
        },
        {
          "Name": "auth-refresh",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/auth/refresh-token",
            "/api/auth/course-management/refresh-token"
          ],
          "PermitLimit": 300,
          "WindowSeconds": 60
        },
        {
          "Name": "auth-login",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/auth/login",
            "/api/auth/coaching/login",
            "/api/auth/speed-reading/login",
            "/api/auth/course-management/login",
            "/api/auth/google-login",
            "/api/auth/google",
            "/api/auth/coaching/google-login",
            "/api/auth/coaching/google",
            "/api/auth/speed-reading/google-login",
            "/api/auth/speed-reading/google",
            "/api/auth/mfa/verify",
            "/api/auth/course-management/mfa/verify"
          ],
          "PathPrefixes": [
            "/api/auth/course-management/login"
          ],
          "PermitLimit": 60,
          "WindowSeconds": 60
        },
        {
          "Name": "auth",
          "PathPrefixes": [
            "/api/auth"
          ],
          "PermitLimit": 120,
          "WindowSeconds": 60
        },
        {
          "Name": "support-submit",
          "Paths": [
            "/api/support/submit"
          ],
          "PermitLimit": 10,
          "WindowSeconds": 60
        },
        {
          "Name": "speed-reading-public-write",
          "Paths": [
            "/api/speed-reading/cms/contact"
          ],
          "PermitLimit": 8,
          "WindowSeconds": 600
        },
        {
          "Name": "speed-reading-public-write",
          "Methods": [
            "POST"
          ],
          "PathPrefixes": [
            "/api/speed-reading/cms/newsletter"
          ],
          "PermitLimit": 8,
          "WindowSeconds": 600
        },
        {
          "Name": "coaching-newsletter-public-write",
          "Methods": [
            "POST"
          ],
          "PathPrefixes": [
            "/api/coaching/cms/newsletter"
          ],
          "PermitLimit": 8,
          "WindowSeconds": 600
        },
        {
          "Name": "bank-transfer-request",
          "Methods": [
            "POST"
          ],
          "Paths": [
            "/api/speed-reading/bank-transfer/requests"
          ],
          "PermitLimit": 5,
          "WindowSeconds": 600
        }
      ]
    },
    "RequestLimits": {
      "MaxRequestBodySizeBytes": 52428800,
      "DefaultMaxRequestBodySizeBytes": 30000000,
      "Rules": [
        {
          "Name": "public-json",
          "PathPrefixes": [
            "/api/auth",
            "/api/coaching/cms/newsletter",
            "/api/speed-reading/cms/newsletter"
          ],
          "Paths": [
            "/api/support/submit",
            "/api/speed-reading/cms/contact",
            "/api/speed-reading/bank-transfer/requests"
          ],
          "MaxRequestBodySizeBytes": 65536
        },
        {
          "Name": "coaching-catalog-import",
          "PathPrefixes": [
            "/api/coaching-admin/catalog-imports"
          ],
          "MaxRequestBodySizeBytes": 52428800
        }
      ]
    },
    "Timeouts": {
      "DefaultSeconds": 100,
      "LongRunningSeconds": 300,
      "LongRunningRouteIds": [
        "coaching-data-export-route",
        "coaching-reports-route"
      ],
      "DisabledPathPrefixes": [
        "/hubs"
      ]
    },
    "Proxy": {
      "ActivityTimeoutSeconds": 330,
      "PooledConnectionLifetimeSeconds": 120,
      "HealthChecksEnabled": true,
      "ActiveHealthCheckPath": "/health/live",
      "ActiveHealthCheckIntervalSeconds": 15,
      "ActiveHealthCheckTimeoutSeconds": 5,
      "PassiveReactivationSeconds": 30
    }
  },
