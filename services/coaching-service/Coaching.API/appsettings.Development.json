{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    },
    "EnableSensitiveDataLogging": false
  },
  "RabbitMQ": {
    "Host": "localhost"
  },
  "Coaching": {
    "Attachments": {
      "Provider": "Local",
      "RootPath": "./data/attachments",
      "UploadUrlLifetimeMinutes": 15,
      "Scanner": {
        "Provider": "Local",
        "ClamAvHost": "localhost",
        "ClamAvPort": 3310,
        "TimeoutSeconds": 10
      }
    }
  },
  "Jwt": {
    "Issuer": "EduPlatform",
    "Audience": "EduPlatform"
  }
}
