{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "EnableSensitiveDataLogging": false
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "http://localhost:8080/realms/eduplatform",
    "Audience": "account"
  },
  "RabbitMQ": {
    "Host": "localhost"
  },
  "Coaching": {
    "Attachments": {
      "Provider": "Local",
      "RootPath": "./data/attachments",
      "UploadUrlLifetimeMinutes": 15,
      "MinioEndpoint": "localhost:9000",
      "MinioAccessKey": "",
      "MinioSecretKey": "",
      "MinioBucket": "eduplatform-attachments",
      "MinioUseSsl": false,
      "Scanner": {
        "Provider": "Local",
        "ClamAvHost": "localhost",
        "ClamAvPort": 3310,
        "TimeoutSeconds": 10
      }
    }
  },
  "Serilog": {
    "SeqUrl": "http://localhost:5341"
  }
}
