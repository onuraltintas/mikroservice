{
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "module": "preserve",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true }
}
