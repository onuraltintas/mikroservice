FROM node:22.14.0-alpine AS build
WORKDIR /workspace/clients/admin-panel

COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY admin-panel/ ./
COPY shared/ /workspace/clients/shared/
RUN npm run build -- --project staff-portal --configuration production --base-href /staff/

FROM nginx:1.27.5-alpine AS runtime
COPY admin-panel/projects/staff-portal/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/clients/admin-panel/dist/staff-portal/browser /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD wget --spider --no-verbose http://127.0.0.1/health/live || exit 1
