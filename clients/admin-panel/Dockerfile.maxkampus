FROM node:22.14.0-alpine AS build
WORKDIR /workspace/clients/admin-panel

COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci --legacy-peer-deps --ignore-scripts

COPY admin-panel/ ./
COPY shared/ /workspace/clients/shared/
RUN npm run build -- --project maxkampus --configuration production

# Unprivileged nginx: runs as UID 101 and listens on 8080.
FROM nginxinc/nginx-unprivileged:1.27.5-alpine AS runtime
COPY admin-panel/projects/maxkampus/nginx.conf /etc/nginx/conf.d/default.conf
COPY admin-panel/projects/maxkampus/nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /workspace/clients/admin-panel/dist/maxkampus/browser /usr/share/nginx/html

EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD wget --spider --no-verbose http://127.0.0.1:8080/health/live || exit 1
