+  gateway-tests:
+    name: Gateway tests
+    runs-on: ubuntu-latest
+    needs: [source-safety, dotnet]
+    services:
+      redis:
+        image: redis:7.2-alpine
+        ports:
+          - 6379:6379
+        options: >-
+          --health-cmd "redis-cli ping"
+          --health-interval 5s
+          --health-timeout 3s
+          --health-retries 10
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: ${{ env.DOTNET_VERSION }}
+
+      - name: Run gateway host, rate-limit and resilience tests
+        env:
+          GATEWAY_TEST_REDIS_HOST: 127.0.0.1
+          GATEWAY_TEST_REDIS_PORT: 6379
+        run: >-
+          dotnet test tests/Unit/EduPlatform.Gateway.UnitTests/EduPlatform.Gateway.UnitTests.csproj
+          --configuration Release --logger "trx;LogFileName=gateway-tests.trx"
+
+      - name: Upload test results
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: gateway-test-results
+          path: tests/Unit/EduPlatform.Gateway.UnitTests/TestResults/
+          if-no-files-found: warn
+
