<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FixtureContext Condition="'$(FixtureContext)' == ''">Identity</FixtureContext>
    <AssemblyName>$(FixtureContext)Fixture</AssemblyName>
    <DefineConstants Condition="'$(FixtureContext)' == 'Identity'">$(DefineConstants);IDENTITY_FIXTURE</DefineConstants>
    <RuntimeSources>$(MSBuildThisFileDirectory)../../../../.tmp/coaching-release-ac014834/out</RuntimeSources>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="$(RuntimeSources)/identity/*.dll" Condition="'$(FixtureContext)' == 'Identity'" />
    <Reference Include="$(RuntimeSources)/coaching/*.dll" Condition="'$(FixtureContext)' == 'Coaching'" />
  </ItemGroup>
</Project>
