-- KM2 step 3 (only after the coaching team approved data/tdp-matematik-estimates.csv; safe to repeat):
--   psql ... -v approval_reason='<5-200 karakter onay gerekçesi>' < 03-apply-tdp-estimates.sql
-- Fills EstimatedMinutes of the TDP "Matematik (Destek)" leaves with the reviewed "koçluk tahmini" values. It only fills
-- empty values (a minute value someone already set is kept) and never touches YieldWeight (stays 3: TDP has no exam, so
-- there is no exam frequency to weight). This changes live planning durations, which is why it is a separate, opt-in step.
-- Generated by build.py; do not edit by hand.
\set ON_ERROR_STOP on
\if :{?approval_reason}
\else
  \set approval_reason ''
\endif
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL search_path = coaching;
SELECT set_config('km2.approval_reason', :'approval_reason', true) AS reason \gset km2_
DO $$
BEGIN
  IF length(btrim(current_setting('km2.approval_reason'))) NOT BETWEEN 5 AND 200 THEN
    RAISE EXCEPTION 'km2 tdp refused: pass -v approval_reason=<5-200 karakter onay gerekçesi>';
  END IF;
END $$;
SELECT pg_advisory_xact_lock(hashtext('coaching-catalog-km2'));
LOCK TABLE study_catalog_topics IN SHARE ROW EXCLUSIVE MODE;

CREATE TEMP TABLE km2_tdp(topic_source_id text PRIMARY KEY, proposed_minutes int NOT NULL) ON COMMIT DROP;
INSERT INTO km2_tdp VALUES
{{TDP_VALUES}};

CREATE TEMP TABLE km2_tdp_resolved ON COMMIT DROP AS
SELECT k.*, t."Id" topic_id, t."EstimatedMinutes" before_minutes
FROM km2_tdp k
LEFT JOIN study_catalog_topics t ON t."Source"='approved-catalog' AND t."SourceId"=k.topic_source_id
LEFT JOIN study_catalog_lessons l ON l."Id"=t."LessonId"
WHERE l."Source"='approved-catalog' AND l."SourceId"='6283030c-281d-4ff3-1536-08dce12e5803'
  AND NOT EXISTS (SELECT 1 FROM study_catalog_topics c WHERE c."ParentId"=t."Id");

DO $$
BEGIN
  IF (SELECT count(*) FROM km2_tdp_resolved) <> {{TDP_COUNT}} OR (SELECT count(*) FROM km2_tdp) <> {{TDP_COUNT}} THEN
    RAISE EXCEPTION 'km2 tdp refused: the TDP Matematik leaves no longer match the reviewed snapshot';
  END IF;
END $$;

CREATE TEMP TABLE km2_tdp_updated ON COMMIT DROP AS
WITH updated AS (
  UPDATE study_catalog_topics t SET "EstimatedMinutes"=r.proposed_minutes
  FROM km2_tdp_resolved r WHERE t."Id"=r.topic_id AND t."EstimatedMinutes" IS NULL
  RETURNING 1)
SELECT count(*) n FROM updated;

SELECT format('km2 tdp: empty before %s | kept %s | updated %s | empty after %s',
  (SELECT count(*) FROM km2_tdp_resolved WHERE before_minutes IS NULL),
  (SELECT count(*) FROM km2_tdp_resolved WHERE before_minutes IS NOT NULL),
  (SELECT n FROM km2_tdp_updated),
  (SELECT count(*) FROM km2_tdp_resolved r JOIN study_catalog_topics t ON t."Id"=r.topic_id WHERE t."EstimatedMinutes" IS NULL));
SELECT format('km2 tdp approval: %s', btrim(current_setting('km2.approval_reason')));
COMMIT;
