-- KM2 step 1 (passive, safe to repeat): link the AYT Tarih leaves that have no outcome yet to the outcomes of their
-- same-named Tarih (TYT) twin. Every new link is IsApproved=false with no reviewer; students see nothing until the team
-- approves the links in the admin panel (Koçluk yönetimi > Kazanımlar > konu eşleştirmesi) and step 2 runs.
-- Generated by build.py from the 01.11.2026 catalog snapshot; do not edit by hand.
\set ON_ERROR_STOP on
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL search_path = coaching;
SELECT pg_advisory_xact_lock(hashtext('coaching-catalog-km2'));
LOCK TABLE study_catalog_topic_outcomes IN SHARE ROW EXCLUSIVE MODE;

CREATE FUNCTION pg_temp.km2_norm(name text) RETURNS text LANGUAGE sql IMMUTABLE AS $$
  SELECT btrim(regexp_replace(translate(lower(name), '’''`-,.' || chr(160), '       '), '\s+', ' ', 'g'))
$$;

CREATE TEMP TABLE km2_pack(ayt_source_id text, tyt_source_id text, edition_code text, outcome_code text,
  learning_minutes int, practice_minutes int, check_minutes int, evidence text) ON COMMIT DROP;
INSERT INTO km2_pack VALUES
{{AYT_LINK_VALUES}};

CREATE TEMP TABLE km2_resolved ON COMMIT DROP AS
SELECT k.*, a."Id" ayt_id, a."Name" ayt_name, a."IsActive" ayt_active, al."SourceId" ayt_lesson,
  t."Id" tyt_id, t."Name" tyt_name, tl."SourceId" tyt_lesson, o."Id" outcome_id, o."IsArchived" outcome_archived,
  EXISTS (SELECT 1 FROM study_catalog_topics c WHERE c."ParentId"=a."Id") ayt_has_children,
  EXISTS (SELECT 1 FROM study_catalog_topic_outcomes m WHERE m."TopicId"=t."Id" AND m."OutcomeId"=o."Id" AND m."IsApproved") twin_link
FROM km2_pack k
LEFT JOIN study_catalog_topics a ON a."Source"='approved-catalog' AND a."SourceId"=k.ayt_source_id
LEFT JOIN study_catalog_lessons al ON al."Id"=a."LessonId" AND al."Source"='approved-catalog'
LEFT JOIN study_catalog_topics t ON t."Source"='approved-catalog' AND t."SourceId"=k.tyt_source_id
LEFT JOIN study_catalog_lessons tl ON tl."Id"=t."LessonId" AND tl."Source"='approved-catalog'
LEFT JOIN official_curriculum_editions e ON e."Code"=k.edition_code
LEFT JOIN study_catalog_outcomes o ON o."EditionId"=e."Id" AND o."Code"=k.outcome_code;

DO $$
DECLARE problem text;
BEGIN
  SELECT string_agg(DISTINCT coalesce(ayt_name, ayt_source_id) || ' / ' || outcome_code, '; ') INTO problem FROM km2_resolved
  WHERE ayt_id IS NULL OR tyt_id IS NULL OR outcome_id IS NULL OR outcome_archived OR ayt_has_children OR NOT ayt_active
    OR ayt_lesson IS DISTINCT FROM 'c4ee03b3-8384-4963-b599-08dc055fab0e' OR tyt_lesson IS DISTINCT FROM '1db94d28-83dd-4de8-b590-08dc055fab0e'
    OR pg_temp.km2_norm(ayt_name) <> pg_temp.km2_norm(tyt_name) OR NOT twin_link;
  IF problem IS NOT NULL OR (SELECT count(*) FROM km2_resolved) <> {{AYT_LINK_COUNT}}
     OR (SELECT count(DISTINCT ayt_id) FROM km2_resolved) <> {{AYT_TOPIC_COUNT}} THEN
    RAISE EXCEPTION 'km2 stage refused: the catalog no longer matches the reviewed snapshot (%)', coalesce(problem, 'row count');
  END IF;
  -- The twin must still carry exactly the reviewed outcome set (approved links), nothing more and nothing less.
  SELECT string_agg(DISTINCT r.tyt_name, '; ') INTO problem FROM (SELECT DISTINCT tyt_id, tyt_name FROM km2_resolved) r
  WHERE (SELECT array_agg(m."OutcomeId" ORDER BY m."OutcomeId") FROM study_catalog_topic_outcomes m WHERE m."TopicId"=r.tyt_id AND m."IsApproved")
     IS DISTINCT FROM (SELECT array_agg(x.outcome_id ORDER BY x.outcome_id) FROM km2_resolved x WHERE x.tyt_id=r.tyt_id);
  IF problem IS NOT NULL THEN
    RAISE EXCEPTION 'km2 stage refused: the TYT twin outcome set changed (%)', problem;
  END IF;
END $$;

CREATE TEMP TABLE km2_ayt_leaves ON COMMIT DROP AS
SELECT t."Id" FROM study_catalog_topics t JOIN study_catalog_lessons l ON l."Id"=t."LessonId"
WHERE l."Source"='approved-catalog' AND l."SourceId"='c4ee03b3-8384-4963-b599-08dc055fab0e'
  AND NOT EXISTS (SELECT 1 FROM study_catalog_topics c WHERE c."ParentId"=t."Id");

SELECT format('km2 stage before: pack links %s | present %s | AYT Tarih leaves without links %s',
  (SELECT count(*) FROM km2_resolved),
  (SELECT count(*) FROM km2_resolved r JOIN study_catalog_topic_outcomes m ON m."TopicId"=r.ayt_id AND m."OutcomeId"=r.outcome_id),
  (SELECT count(*) FROM km2_ayt_leaves l WHERE NOT EXISTS (SELECT 1 FROM study_catalog_topic_outcomes m WHERE m."TopicId"=l."Id")));

CREATE TEMP TABLE km2_inserted ON COMMIT DROP AS
WITH inserted AS (
  INSERT INTO study_catalog_topic_outcomes("TopicId", "OutcomeId", "IsApproved", "Evidence", "ReviewedBy", "ReviewedAt")
  SELECT ayt_id, outcome_id, false, evidence, NULL, NULL FROM km2_resolved ORDER BY ayt_id, outcome_id
  ON CONFLICT ("TopicId", "OutcomeId") DO NOTHING
  RETURNING 1)
SELECT count(*) n FROM inserted;

SELECT format('km2 stage after: inserted %s | pending %s | AYT Tarih leaves without links %s',
  (SELECT n FROM km2_inserted),
  (SELECT count(*) FROM km2_resolved r JOIN study_catalog_topic_outcomes m ON m."TopicId"=r.ayt_id AND m."OutcomeId"=r.outcome_id
   WHERE NOT m."IsApproved" AND m."ReviewedBy" IS NULL),
  (SELECT count(*) FROM km2_ayt_leaves l WHERE NOT EXISTS (SELECT 1 FROM study_catalog_topic_outcomes m WHERE m."TopicId"=l."Id")));
COMMIT;
