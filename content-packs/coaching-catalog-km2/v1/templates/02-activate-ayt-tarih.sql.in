-- KM2 step 2 (run only after the team reviewed the step-1 links in the admin panel; safe to repeat):
--   psql ... -v reviewer_id=<admin user id who reviewed> -v reason='<5-200 karakter gerekçe>' < 02-activate-ayt-tarih.sql
-- For every AYT Tarih topic whose KM2 links are ALL reviewed and at least one is approved, and which has no YKS scope yet:
--   * each approved outcome gets a new published duration version (ReviewedStudy, reviewer_id) whose topic shares are the
--     previous published shares unchanged plus one share for the AYT topic (koçluk tahmini: the TYT twin's share);
--   * the topic gets the YKS scopes the 26 already linked AYT Tarih topics use (EA/SÖZ AYT.EDESOS1 = Tarih-1, SÖZ AYT.SOS2 = Tarih-2).
-- Topics with a pending link are skipped untouched. Generated by build.py; do not edit by hand.
\set ON_ERROR_STOP on
\if :{?reviewer_id}
\else
  \set reviewer_id ''
\endif
\if :{?reason}
\else
  \set reason ''
\endif
BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL search_path = coaching;
SELECT set_config('km2.reviewer_id', :'reviewer_id', true) AS reviewer, set_config('km2.reason', :'reason', true) AS reason \gset km2_
DO $$
BEGIN
  IF current_setting('km2.reviewer_id') !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
     OR current_setting('km2.reviewer_id')::uuid = '00000000-0000-0000-0000-000000000000'
     OR length(btrim(current_setting('km2.reason'))) NOT BETWEEN 5 AND 200 THEN
    RAISE EXCEPTION 'km2 activate refused: pass -v reviewer_id=<reviewing admin user id> -v reason=<5-200 karakter gerekçe>';
  END IF;
END $$;
SELECT pg_advisory_xact_lock(hashtext('coaching-catalog-km2'));
LOCK TABLE study_catalog_topic_outcomes, outcome_duration_estimates, study_catalog_topic_outcome_shares, study_catalog_yks_scopes
  IN SHARE ROW EXCLUSIVE MODE;

CREATE TEMP TABLE km2_pack(ayt_source_id text, tyt_source_id text, edition_code text, outcome_code text,
  learning_minutes int, practice_minutes int, check_minutes int, evidence text) ON COMMIT DROP;
INSERT INTO km2_pack VALUES
{{AYT_LINK_VALUES}};

CREATE TEMP TABLE km2_links ON COMMIT DROP AS
SELECT k.*, a."Id" ayt_id, a."Name" ayt_name, o."Id" outcome_id, m."IsApproved" approved, m."ReviewedBy" reviewed_by
FROM km2_pack k
JOIN study_catalog_topics a ON a."Source"='approved-catalog' AND a."SourceId"=k.ayt_source_id
JOIN official_curriculum_editions e ON e."Code"=k.edition_code
JOIN study_catalog_outcomes o ON o."EditionId"=e."Id" AND o."Code"=k.outcome_code
LEFT JOIN study_catalog_topic_outcomes m ON m."TopicId"=a."Id" AND m."OutcomeId"=o."Id";

DO $$
BEGIN
  IF (SELECT count(*) FROM km2_links) <> {{AYT_LINK_COUNT}} OR EXISTS (SELECT 1 FROM km2_links WHERE approved IS NULL) THEN
    RAISE EXCEPTION 'km2 activate refused: run 01-stage-ayt-tarih-links.sql first (pack links missing)';
  END IF;
END $$;

-- Topics ready now: every KM2 link reviewed, at least one approved, active leaf, no YKS scope yet.
CREATE TEMP TABLE km2_ready ON COMMIT DROP AS
SELECT l.ayt_id FROM km2_links l JOIN study_catalog_topics t ON t."Id"=l.ayt_id
WHERE t."IsActive" AND NOT EXISTS (SELECT 1 FROM study_catalog_topics c WHERE c."ParentId"=t."Id")
  AND NOT EXISTS (SELECT 1 FROM study_catalog_yks_scopes s WHERE s."TopicId"=l.ayt_id)
GROUP BY l.ayt_id HAVING bool_and(l.reviewed_by IS NOT NULL) AND bool_or(l.approved);

-- Approved links on ready topics, with the outcome's current published estimate (the highest published number).
CREATE TEMP TABLE km2_todo ON COMMIT DROP AS
SELECT l.*, e."Id" estimate_id, e."Number" estimate_number,
  (SELECT max(x."Number") FROM outcome_duration_estimates x WHERE x."OutcomeId"=l.outcome_id) max_number
FROM km2_links l JOIN km2_ready r ON r.ayt_id=l.ayt_id
LEFT JOIN outcome_duration_estimates e ON e."OutcomeId"=l.outcome_id AND e."IsPublished"
  AND NOT EXISTS (SELECT 1 FROM outcome_duration_estimates n WHERE n."OutcomeId"=l.outcome_id AND n."IsPublished" AND n."Number">e."Number")
WHERE l.approved
  AND NOT EXISTS (SELECT 1 FROM study_catalog_topic_outcome_shares s WHERE s."TopicId"=l.ayt_id AND s."OutcomeId"=l.outcome_id AND s."EstimateId"=e."Id");

DO $$
DECLARE problem text;
BEGIN
  -- OutcomeScopeBudget: the current shares must cover exactly the approved active topics other than the new AYT ones.
  SELECT string_agg(DISTINCT d.outcome_code, ', ') INTO problem FROM km2_todo d
  WHERE d.estimate_id IS NULL
     OR (SELECT array_agg(s."TopicId" ORDER BY s."TopicId") FROM study_catalog_topic_outcome_shares s WHERE s."EstimateId"=d.estimate_id)
        IS DISTINCT FROM (SELECT array_agg(m."TopicId" ORDER BY m."TopicId") FROM study_catalog_topic_outcomes m
          JOIN study_catalog_topics t ON t."Id"=m."TopicId"
          WHERE m."OutcomeId"=d.outcome_id AND m."IsApproved" AND t."IsActive"
            AND m."TopicId" NOT IN (SELECT x.ayt_id FROM km2_todo x WHERE x.outcome_id=d.outcome_id));
  IF problem IS NOT NULL THEN
    RAISE EXCEPTION 'km2 activate refused: published durations do not cover the approved topics for %', problem;
  END IF;
END $$;

CREATE TEMP TABLE km2_estimates ON COMMIT DROP AS
SELECT d.outcome_id, min(d.estimate_id::text)::uuid previous_id, max(d.max_number) + 1 number,
  md5('km2:' || d.outcome_id || ':' || (max(d.max_number) + 1))::uuid id,
  sum(d.learning_minutes) add_learning, sum(d.practice_minutes) add_practice, sum(d.check_minutes) add_check
FROM km2_todo d GROUP BY d.outcome_id;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM km2_estimates GROUP BY outcome_id HAVING count(DISTINCT previous_id) > 1)
     OR EXISTS (SELECT 1 FROM km2_estimates k JOIN outcome_duration_estimates e ON e."Id"=k.previous_id
       WHERE e."LearningMinutes"::bigint + e."PracticeMinutes" + e."CheckMinutes" + k.add_learning + k.add_practice + k.add_check > 1440) THEN
    RAISE EXCEPTION 'km2 activate refused: a new duration version would exceed 1440 minutes';
  END IF;
END $$;

CREATE TEMP TABLE km2_counts(kind text, n bigint) ON COMMIT DROP;
WITH inserted AS (
  INSERT INTO outcome_duration_estimates("Id", "OutcomeId", "Number", "LearningMinutes", "PracticeMinutes", "CheckMinutes",
    "Method", "Confidence", "Evidence", "ReviewedBy", "ReviewedAt", "IsPublished")
  SELECT k.id, k.outcome_id, k.number, e."LearningMinutes" + k.add_learning, e."PracticeMinutes" + k.add_practice,
    e."CheckMinutes" + k.add_check, 'ReviewedStudy', 'Low',
    left('KM2 koçluk tahmini: AYT Tarih konu payı aynı başlıklı Tarih (TYT) konusunun yayımlı payıyla aynı alındı; önceki konu payları '
      || 'değişmedi. Önceki sürüm ' || e."Number" || '. Gerekçe: ' || btrim(current_setting('km2.reason')), 2000),
    current_setting('km2.reviewer_id')::uuid, now(), true
  FROM km2_estimates k JOIN outcome_duration_estimates e ON e."Id"=k.previous_id
  RETURNING 1)
INSERT INTO km2_counts SELECT 'estimates', count(*) FROM inserted;

WITH inserted AS (
  INSERT INTO study_catalog_topic_outcome_shares("TopicId", "OutcomeId", "EstimateId", "LearningMinutes", "PracticeMinutes",
    "CheckMinutes", "ScopeDescription")
  SELECT s."TopicId", s."OutcomeId", k.id, s."LearningMinutes", s."PracticeMinutes", s."CheckMinutes", s."ScopeDescription"
  FROM km2_estimates k JOIN study_catalog_topic_outcome_shares s ON s."EstimateId"=k.previous_id
  UNION ALL
  SELECT d.ayt_id, d.outcome_id, k.id, d.learning_minutes, d.practice_minutes, d.check_minutes, d.ayt_name
  FROM km2_todo d JOIN km2_estimates k ON k.outcome_id=d.outcome_id
  RETURNING 1)
INSERT INTO km2_counts SELECT 'shares', count(*) FROM inserted;

WITH inserted AS (
  INSERT INTO study_catalog_yks_scopes("TopicId", "ScoreType", "TestCode", "ExamCode", "ForeignLanguage", "Evidence", "ExcludedOutcomeIds")
  SELECT r.ayt_id, v.score_type, v.test_code, 'AYT', NULL,
    'KM2: ÖSYM 2026 AYT soru kitapçığı (Tarih-1 TDE-SB1, Tarih-2 SB2; ikisi de tüm dönemler) ve mevcut AYT Tarih konularıyla aynı kapsam. '
    || '2027 resmî kapsam iddiası değildir. https://dokuman.osym.gov.tr/pdfdokuman/2026/YKS/TSK/yks_ayt_2026_kitapcik_kt12.pdf', '{}'
  FROM km2_ready r CROSS JOIN (VALUES ('EA', 'AYT.EDESOS1'), ('SOZ', 'AYT.EDESOS1'), ('SOZ', 'AYT.SOS2')) v(score_type, test_code)
  ON CONFLICT DO NOTHING
  RETURNING 1)
INSERT INTO km2_counts SELECT 'scopes', count(*) FROM inserted;

SELECT format('km2 activate: reviewed topics %s | estimates %s | shares %s | scopes %s',
  (SELECT count(*) FROM km2_ready), (SELECT n FROM km2_counts WHERE kind='estimates'),
  (SELECT n FROM km2_counts WHERE kind='shares'), (SELECT n FROM km2_counts WHERE kind='scopes'));
COMMIT;
